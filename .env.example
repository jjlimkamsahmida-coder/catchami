# Copy to .env (git-ignored) and fill in what you need. Restart the server after changes.

# Network: dev | testnet | mainnet
CATCHAMI_NETWORK=dev

# Optional — stricter animal check + tighter sticker box with an OpenAI vision model.
# Without it, the free on-server detector (COCO-SSD + DeepLab) is used.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# NEAR (testnet) — needed only for on-chain minting/settlement, not for wallet sign-in.
NEAR_RPC_URL=
NEAR_TOKEN_CONTRACT=
NEAR_GAME_CONTRACT=
