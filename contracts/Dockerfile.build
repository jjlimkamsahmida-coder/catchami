# Contract build/test image: Rust + wasm target + cargo-near (reproducible wasm builds).
#   docker build -t catchami-contracts -f contracts/Dockerfile.build contracts
#   docker run --rm -v "$PWD/contracts:/work" -w /work catchami-contracts cargo test
#   docker run --rm -v "$PWD/contracts:/work" -w /work/game catchami-contracts cargo near build non-reproducible-wasm --no-abi
FROM rust:1.99
RUN apt-get update && apt-get install -y --no-install-recommends libudev-dev pkg-config && rm -rf /var/lib/apt/lists/*
RUN rustup target add wasm32-unknown-unknown
ENV CARGO_BUILD_JOBS=4
RUN cargo install cargo-near --version 0.23.0 --locked
