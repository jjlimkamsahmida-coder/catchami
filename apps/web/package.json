    "@near-wallet-selector/sender": "10.1.4",
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow/tfjs": "4.22.0",
    "buffer": "6.0.3",
    "near-api-js": "5.1.1",
    "phaser": "3.90.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.0",
