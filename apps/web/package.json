    "dev:nearauth": "node -e \"process.env.CATCHAMI_NEAR_AUTH_DEV='1';require('child_process').spawn('vite',{stdio:'inherit',shell:true,env:process.env})\"",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@catchami/shared": "workspace:*",
    "@fast-auth-near/javascript-provider": "1.4.1",
