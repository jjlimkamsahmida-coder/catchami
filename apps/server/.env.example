# Copy to your host's secret manager (never commit real values).
CATCHAMI_NETWORK=dev            # dev | testnet | mainnet
PORT=8797
# DATABASE_URL=postgres://user:pass@host:5432/catchami   # omit in dev to use embedded PGlite in DATA_DIR
DATA_DIR=./data
MEDIA_DIR=./data/media
# SESSION_SECRET=<at least 32 random characters>          # required outside dev
# ADMIN_TOKEN=<random>                                    # dev prints one on startup
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NEAR (testnet/mainnet only)
# NEAR_RPC_URL=https://rpc.testnet.near.org
# NEAR_TOKEN_CONTRACT=token.catchami-dev.testnet
# NEAR_GAME_CONTRACT=game.catchami-dev.testnet
# NEAR_OPERATOR_ACCOUNT=operator.catchami-dev.testnet
# NEAR_OPERATOR_KEY_FILE=/run/secrets/operator.json   # or NEAR_OPERATOR_KEY=ed25519:...
# NEAR_MARKET_ACCOUNT=market.catchami-dev.testnet
# NEAR_MARKET_KEY_FILE=/run/secrets/market.json        # or NEAR_MARKET_KEY=ed25519:...
# NEAR_REF_POOL_ID=2969
# PUBLIC_URL=https://catchami-production.up.railway.app   # NFT media links
# (full list and what is simulated: docs/TESTNET.md)

# Legal release control for real-token PvP. Leave unset until written legal sign-off exists.
# REAL_PVP_APPROVED=
